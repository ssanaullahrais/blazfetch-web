# BlazFetch frontend settings. Copy this file to `.env.local` (development) or `.env.production` (production build)
# and change only what you need. Every line below shows its DEFAULT: a variable you leave out behaves exactly as written.
# These are read when the app is built or started, so restart `pnpm dev` (or rebuild) after changing them.

## =====================================================================================================
## Backend
## =====================================================================================================
# Where the API lives. Empty = the same origin as the site (RECOMMENDED: put the app and /api behind one reverse
# proxy, see docs/DEPLOYMENT.md). Set it only when the API is on another origin, and add this site to the
# backend's CORS_ALLOWED_ORIGINS.
VITE_API_BASE=

## =====================================================================================================
## Counters
## Each is shown unless set to "false". The first three are the footer counters; the last is the download count
## in every social icon's tooltip on the home page (the name, then a download icon and the count).
## =====================================================================================================
VITE_SHOW_FETCH_STATS=true
VITE_SHOW_DOWNLOAD_STATS=true
VITE_SHOW_ONLINE_VISITORS=true
VITE_SHOW_PLATFORM_DOWNLOADS=true

## =====================================================================================================
## Progressive web app
## Installable app with an offline shell, an "Install app" button and a floating install card that shows for a few
## seconds on each visit until the app is installed. On by default; "false" builds a plain website (visitors who
## installed an earlier build are cleaned up on their next visit). Install is desktop-only either way: phones and
## tablets never see the install button or card, since a PWA install prompt is unreliable there across browsers.
## =====================================================================================================
VITE_ENABLE_PWA=true

## =====================================================================================================
## Audio
## Play button on audio rows. RECOMMENDED: true, together with AUDIO_FORCE_MP3=true on the backend, so every track is an MP3 that plays
## everywhere. If the line is left out the built-in default is false, because without MP3 most audio is M4A/WebM, which is not a plain MP3 to preview. Play fetches the audio once
## into the page's memory (nothing is kept on the server); pressing Download afterwards saves that same file with no second request, and
## it is freed when a new link is loaded.
## (To deliver every audio download as MP3, set AUDIO_FORCE_MP3=true in the BACKEND's .env: the audio tab then lists MP3.)
## =====================================================================================================
VITE_ENABLE_AUDIO_PREVIEW=true

## =====================================================================================================
## Video compatibility on phones
## A video format flagged "may not play everywhere" (VP9/AV1/etc.) is hidden from the format list on a narrow,
## phone-width screen (under 768px — the same breakpoint the rest of the app already uses), where many devices and
## browsers can't decode it at all. A wide (desktop) screen always shows every format, since that's rarely a real
## problem there. A source with nothing compatible left still shows every format rather than an empty list.
## RECOMMENDED: true (default). Set to false to show every format at every width, no filtering.
## =====================================================================================================
VITE_HIDE_INCOMPATIBLE_VIDEO_ON_PHONE=true

## =====================================================================================================
## Branding and SEO (see docs/BRANDING.md)
## Defaults live in src/config/site.ts; set a variable here only to override it. VITE_SITE_URL should be your real
## public domain (canonical links, sitemap, share images).
## =====================================================================================================
# VITE_SITE_NAME=BlazFetch
# VITE_SITE_TAGLINE=Paste a link, save any video, audio or photo.
# VITE_SITE_DESCRIPTION=
# VITE_SITE_URL=https://your-domain.example
# VITE_SITE_KEYWORDS=
# VITE_SITE_THEME_COLOR=
# VITE_SITE_LANGUAGE=en
# VITE_SITE_TWITTER=
